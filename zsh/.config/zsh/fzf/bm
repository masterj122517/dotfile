b() {
  local bookmarks_path="$HOME/Library/Application Support/Google/Chrome/Default/Bookmarks"
  local jq_script selection url

  [[ -r $bookmarks_path ]] || {
    print -u2 "b: Chrome bookmarks not found: $bookmarks_path"
    return 1
  }
  (( $+commands[jq] && $+commands[open] )) || {
    print -u2 'b: jq and open are required'
    return 1
  }

  jq_script='
    def ancestors: while(. | length >= 2; del(.[-1,-2]));
    . as $in | paths(.url?) as $key | $in | getpath($key) |
    {name, url, path: [$key[0:-2] | ancestors as $a | $in | getpath($a) | .name?] |
    reverse | join("/")} | .path + "/" + .name + "\t" + .url'

  selection=$(command jq -r "$jq_script" < "$bookmarks_path" |
    fzf --delimiter=$'\t' --with-nth=1)
  [[ -n $selection ]] || return
  url=${selection##*$'\t'}
  command open "$url"
}

b
