_fps() {
  local pgid
  pgid=$(command ps -o pgid= -p $$) || return
  pgid=${pgid//[[:space:]]/}

  command ps -eo user,pid,ppid,pgid,stat,tty,command |
    awk -v pgid="$pgid" 'NR == 1 || $4 != pgid || $2 == pgid'
}

setopt localoptions pipefail

local -a fzf_opts pids
local pid separator=''
fzf_opts=(
  --header-lines=1 -m
  ${commands[grcat]:+--ansi} --height=50%
  --min-height=15 --tac --reverse
  --preview-window=down:2
)

if (( $+commands[grcat] )); then
  pids=("${(@f)$(_fps | command grcat fps.grc |
    fzf "${fzf_opts[@]}" --preview 'ps -o pcpu,pmem,vsz,rss,lstart,time -p {2}' |
    awk '{print $2}')}")
else
  pids=("${(@f)$(_fps |
    fzf "${fzf_opts[@]}" --preview 'ps -o pcpu,pmem,vsz,rss,lstart,time -p {2}' |
    awk '{print $2}')}")
fi
[[ -n $pids[1] ]] || return 1

for pid in "${pids[@]}"; do
  print -rn -- "$separator$pid"
  separator=${FZF_MUL_DELIM:-' '}
done
(( $#pids )) && print
