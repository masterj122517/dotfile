local choice command_name
choice=$(print -l \
  'bcp    [brew:clean]' \
  'bip    [brew:install]' \
  'bup    [brew:update]' \
  'cani   [caniuse:features]' \
  'fp     [find:path]' \
  'kp     [kill:process]' \
  'ks     [kill:tcp]' \
  'lg     [lazygit]' \
  'r      [yazi]' \
  's      [fastfetch]' |
  fzf --header='[utils:show]')
[[ -n $choice ]] || return
command_name=${choice%%[[:space:]]*}

case $command_name in
  (bcp) bcp ;;
  (bip) bip ;;
  (bup) bup ;;
  (cani) cani ;;
  (fp) fp ;;
  (kp) kp ;;
  (ks) ks ;;
  (lg) lazygit ;;
  (r) r ;;
  (s) fastfetch ;;
esac

