
da() {
  local cid
  cid=$(command docker ps -a | fzf --header-lines=1 -1 -q "${1:-}" | awk '{print $1}')
  [[ -n $cid ]] && command docker start -- "$cid" && command docker attach "$cid"
}

ds() {
  local cid
  cid=$(command docker ps | fzf --header-lines=1 -q "${1:-}" | awk '{print $1}')
  [[ -n $cid ]] && command docker stop -- "$cid"
}

drm_one() {
  local cid
  cid=$(command docker ps -a | fzf --header-lines=1 -q "${1:-}" | awk '{print $1}')
  [[ -n $cid ]] && command docker rm -- "$cid"
}

drm_multi() {
  local selected
  local -a cids
  selected=$(command docker ps -a | fzf --header-lines=1 -q "${1:-}" --no-sort -m --tac | awk '{print $1}')
  [[ -n $selected ]] || return
  cids=("${(@f)selected}")
  command docker rm -- "${cids[@]}"
}

drmi() {
  local selected
  local -a image_ids
  selected=$(command docker images | fzf --header-lines=1 -q "${1:-}" --no-sort -m --tac | awk '{print $3}')
  [[ -n $selected ]] || return
  image_ids=("${(@f)selected}")
  command docker rmi -- "${image_ids[@]}"
}

D() {
  local choice
  choice=$(print -l \
    'da: Start + attach a stopped container' \
    'ds: Stop a running container' \
    'drm_one: Remove a container (single)' \
    'drm_multi: Remove containers (multi-select)' \
    'drmi: Remove docker images' |
    fzf --prompt='Choose docker action: ')

  case $choice in
    da:*) da ;;
    ds:*) ds ;;
    drm_one:*) drm_one ;;
    drm_multi:*) drm_multi ;;
    drmi:*) drmi ;;
  esac
}

D "$@"
