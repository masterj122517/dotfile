setopt localoptions pipefail

local selected ret event command_text
selected=$(fc -rl 1 | sort -k 2 -u | sort -rn |
  fzf --height 50% -n2..,.. --tiebreak=index --bind=ctrl-r:toggle-sort --query="$1" +m)
ret=$?
if [[ -n $selected ]]; then
  read -r event command_text <<< "$selected"
  print -r -- "$event"
fi
return $ret
