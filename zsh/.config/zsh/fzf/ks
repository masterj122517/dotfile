setopt localoptions pipefail
local selected
local signal=${1:-9}
local -a pids

while true; do
  selected=$(command lsof -Pwni tcp | fzf --header-lines=1 -m --header='[kill:tcp]' | awk '{print $2}') || return
  [[ -n $selected ]] || return
  pids=("${(@f)selected}")
  command kill -"$signal" -- "${pids[@]}"
done

