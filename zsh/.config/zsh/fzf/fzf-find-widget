local ret=0 match dir base token tilde_home extra_opts_string='' opt
local -a tokens cmd_opts extra_fzf_opts
tokens=(${(z)LBUFFER})
if [[ $1 == only_dir ]]; then
  cmd_opts+=(-d)
  extra_fzf_opts+=(+m)
fi

if (( $#tokens )) && [[ $LBUFFER[-1] != ' ' ]]; then
  token=${tokens[-1]}
  local typed_dir=${(Q)token}
  [[ $typed_dir == '~' || $typed_dir == '~/'* ]] && tilde_home=$HOME
  _fzf_expand_path "$token"
  dir=$REPLY

  if [[ ! -d $dir ]]; then
    base=${dir:t}
    dir=${dir:h}
  fi
  cmd_opts+=(-s "$dir")
  [[ -n $base ]] && extra_fzf_opts+=(--query "$base")
else
  dir=
fi

for opt in "${extra_fzf_opts[@]}"; do
  extra_opts_string+="${extra_opts_string:+ }${(q)opt}"
done
match=$(FFIND_TILDE_HOME="$tilde_home" EXTRA_OPTS="$extra_opts_string" ffind "${cmd_opts[@]}")
ret=$?

if (( (ret == 0 || ret == 141) && ${#match} )); then
  if (( $#tokens )) && [[ $LBUFFER[-1] != ' ' ]]; then
    if (( $#tokens == 1 )); then
      LBUFFER=$match
    else
      LBUFFER="${tokens[1,-2]} $match"
    fi
  else
    LBUFFER+=$match
  fi
fi
zle reset-prompt
return $ret
