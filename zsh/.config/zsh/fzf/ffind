setopt localoptions no_pipefail

local s_path level only_dir opt item separator='' ret
local -a find_args fzf_opts extra_opts selected
while getopts ':dl:s:' opt; do
  case $opt in
    (d) only_dir=1 ;;
    (l) level=$OPTARG ;;
    (s) s_path=$OPTARG ;;
    (\?) print -u2 "Invalid option -$OPTARG."; return 1 ;;
  esac
done

find_args=(-L "${s_path:-.}" -mindepth 1)
[[ -n $level ]] && find_args+=(-maxdepth "$level")
find_args+=(
  \( -path '*/.git' -o -path '*/venv' -o -fstype sysfs -o -fstype devfs -o -fstype devtmpfs -o -fstype proc \) -prune
  -o -type d -print
)
[[ -n $only_dir ]] || find_args+=(-o -type f -print -o -type l -print)

fzf_opts=(
  --height=50% --reverse -m --tiebreak=end
  --preview-window=right:60%:wrap
  --bind=ctrl-alt-u:preview-up,ctrl-alt-e:preview-down
)
extra_opts=(${(z)${EXTRA_OPTS:-}})

selected=("${(@f)$(command find "${find_args[@]}" 2>/dev/null |
  while IFS= read -r item; do
    [[ -n $s_path && $s_path != . ]] || item=${item#./}
    print -r -- "$item"
  done |
  fzf "${fzf_opts[@]}" --preview "${fzf_preview_cmd:-bat --color=always --style=plain -- {} 2>/dev/null || eza --tree --level=1 --color=always -- {}}" "${extra_opts[@]}")}")
ret=$?
(( ret == 0 )) || return $ret
[[ -n $selected[1] ]] || return 1

for item in "${selected[@]}"; do
  if [[ -n ${FFIND_TILDE_HOME:-} && $item == "$FFIND_TILDE_HOME"(|/*) ]]; then
    item="~${item#$FFIND_TILDE_HOME}"
  fi
  print -rn -- "$separator${(q)item}"
  separator=' '
done
(( $#selected )) && print
return $ret
