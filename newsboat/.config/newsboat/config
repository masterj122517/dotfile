#show-read-feeds no
auto-reload no
external-url-viewer "urlscan -dc -r 'linkhandler {}'"

bind-key j down
bind-key k up
bind-key j next articlelist
bind-key k prev articlelist
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key G end
bind-key g home
bind-key d pagedown
bind-key u pageup
bind-key l open
bind-key h quit
bind-key a toggle-article-read
bind-key n next-unread
bind-key N prev-unread
bind-key D pb-download
bind-key U show-urls
bind-key x pb-delete


# 默认浏览器设置（假设您已在系统路径中配置了 linkhandler）
browser linkhandler
macro , open-in-browser

# t: 使用 qndl 下载
macro t set browser "qndl" ; open-in-browser ; set browser linkhandler

# a: 下载音频 (使用 tsp 队列)
macro a set browser "ts yt-dlp --embed-metadata -xic -f bestaudio/best" ; open-in-browser ; set browser linkhandler

# A: 下载视频 (使用 tsp 队列)
macro A set browser "ts yt-dlp --merge-output-format mp4 -f 'bestvideo+bestaudio'" ; open-in-browser ; set browser linkhandler

macro m set browser "ts-manager" ; open-in-browser ; set browser linkhandler

# v: 使用 mpv 播放
macro v set browser "nohup mpv --quiet %u >/dev/null 2>&1 &" ; open-in-browser ; set browser linkhandler

# w: 使用终端浏览器 lynx
macro w set browser "lynx" ; open-in-browser ; set browser linkhandler

# d: 使用 fzf 替代 dmenu (这里假设您有一个处理脚本，或直接调用选择器)
# 如果您没有现成的脚本，我可以为您写一个简单的 fzf-handler
macro d set browser "fzf-handler" ; open-in-browser ; set browser linkhandler

# c: 复制链接到剪贴板
macro c set browser "echo %u | pbcopy" ; open-in-browser ; set browser linkhandler

# C: 查看评论
macro C set browser "youtube-viewer --comments=%u" ; open-in-browser ; set browser linkhandler

# p & P: 使用 Motrix 下载种子/磁力链接
# Motrix 支持通过 open 直接接管磁力链接和种子地址
macro p set browser "open -a Motrix %u" ; open-in-browser ; set browser linkhandler
macro P set browser "open -a Motrix %u" ; open-in-browser ; set browser linkhandler

# 按下 ,l (link) 将整篇文章喂给 picker
macro l pipe-to "link-picker"

# --- Catppuccin Mocha 配色方案 ---
# 背景: #1e1e2e (default)
# 文本: #cdd6f4 (white)
# 选中: #f9e2af (yellow)
# 未读: #89b4fa (blue)

# 列表基础颜色
color listnormal         cyan    default
color listfocus          black   yellow  standout bold
color listnormal_unread  blue    default
color listfocus_unread   yellow  default  bold
color info               red     black   bold
color article            white   default bold

# --- 文本高亮 (Highlighting) ---

# 分隔线
highlight all "---.*---" yellow

# 已读完的 Feed (0/0) 变暗隐藏
highlight feedlist ".*(0/0))" black

# 文章头部信息
highlight article "(^Feed:.*|^Title:.*|^Author:.*)" cyan default bold
highlight article "(^Link:.*|^Date:.*)" default default

# 链接颜色 (Catppuccin Green)
highlight article "https?://[^ ]+" green default

# 标题行 (Catppuccin Blue)
highlight article "^(Title):.*$" blue default

# 链接编号 [1], [2] (Catppuccin Magenta)
highlight article "\\[[0-9][0-9]*\\]" magenta default bold

# 图片与 Flash 占位符
highlight article "\\[image\\ [0-9]+\\]" green default bold
highlight article "\\[embedded flash: [0-9][0-9]*\\]" green default bold

# 链接描述标签
highlight article ":.*\\(link\\)$" cyan default
highlight article ":.*\\(image\\)$" blue default
highlight article ":.*\\(embedded flash\\)$" magenta default
