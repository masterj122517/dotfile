#font-family = "Comic Code Ligatures"
font-family = "IosevkaCustom"
font-family = "LXGW WenKai Mono"

font-style = "Medium"
font-style-bold = "Semibold"
font-style-italic = "Medium Italic"
font-style-bold-italic = "Semibold Italic"

font-feature = +liga
font-feature = +calt

font-size = 11.0

#font-thicken = true

grapheme-width-method = "unicode"

mouse-hide-while-typing = true

window-padding-balance = true

shell-integration = zsh
term = xterm-256color
clipboard-read = allow
clipboard-write = allow
background-opacity = 1
background-blur = 32

theme = masterj

scrollback-limit = 100000

window-width = 120
window-height = 30

# Window & Minimalist Settings
window-decoration = false
gtk-tabs-location = hidden
mouse-hide-while-typing = true
confirm-close-surface = false
copy-on-select = clipboard

keybind = alt+one=unbind
keybind = alt+two=unbind
keybind = alt+three=unbind
keybind = alt+four=unbind
keybind = alt+five=unbind
keybind = alt+six=unbind
keybind = alt+seven=unbind
keybind = alt+eight=unbind
keybind = alt+nine=unbind
