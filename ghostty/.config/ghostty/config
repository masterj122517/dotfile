
# font-family = GeistMono Nerd Font Mono
font-family = "Comic Code Ligatures"
font-style = "Medium"
font-family = "LXGW WenKai Mono"

font-family-bold = "Comic Code Ligatures"
font-style-bold = "Semibold"

font-family-italic = "Comic Code Ligatures"
font-style-italic = "Medium Italic"

font-family-bold-italic = "Comic Code Ligatures"
font-style-bold-italic = "Semibold Italic"

font-feature = +liga
font-feature = +calt

font-size = 15.0

# font-thicken = true

grapheme-width-method = "unicode"

mouse-hide-while-typing = true

window-padding-balance = true
# window-colorspace = display-p3
macos-titlebar-style = tabs

shell-integration = zsh
term = xterm-256color
clipboard-read = allow
clipboard-write = allow
# Kataware owns its dark canvas; transparency shifts every contrast relationship.
background-opacity = 1
background-blur = 0

theme = Kataware

macos-option-as-alt = true

scrollback-limit = 100000

window-width = 120
window-height = 30

# keymaps 
keybind = cmd+a=ignore
