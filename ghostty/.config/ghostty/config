# theme = Horizon 
# theme = JetBrains Darcula 
# theme = Kanagawa Dragon
# theme = Kanagawa Wave 
# theme = kanagawabones 
# theme = Fairyfloss    
theme = AlienBlood

macos-option-as-alt = true
scrollback-limit = 100000

window-height=510
window-width=1640

# keymaps 
keybind =cmd+a=ignore
