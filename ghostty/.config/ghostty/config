palette = 7=#eae3cb
palette = 8=#006488
palette = 9=#f5163b
palette = 10=#51ef84
palette = 11=#b27e28
palette = 12=#178ec8
palette = 13=#e24d8e
palette = 14=#00b39e
palette = 15=#fcf4dc
macos-option-as-alt = true
