font-family = "Iosevka Custom"
font-family = "Symbols Nerd Font Mono"
font-family = "LXGW WenKai Mono"
font-style = "Regular"

font-family-bold = "Iosevka Custom"
font-family-bold = "Symbols Nerd Font Mono"
font-family-bold = "LXGW WenKai Mono"
font-style-bold = "Semibold"

font-family-italic = "Iosevka Custom"
font-family-italic = "Symbols Nerd Font Mono"
font-family-italic = "LXGW WenKai Mono"
font-style-italic = "Italic"

font-family-bold-italic = "Iosevka Custom"
font-family-bold-italic = "Symbols Nerd Font Mono"
font-family-bold-italic = "LXGW WenKai Mono"
font-style-bold-italic = "Semibold Italic"

font-feature = +liga
font-feature = +calt

font-size = 20.0

# font-thicken = true

grapheme-width-method = "unicode"

mouse-hide-while-typing = true

window-padding-balance = true
# window-colorspace = display-p3
macos-titlebar-style = tabs

shell-integration = zsh
term = xterm-256color
clipboard-read = allow
clipboard-write = allow
# Kataware owns its dark canvas; transparency shifts every contrast relationship.
#background-opacity = 1
#background-blur = 0
background-opacity = 0.8
background-blur = 32

theme = Kataware

macos-option-as-alt = true

scrollback-limit = 100000

window-width = 120
window-height = 30

# keymaps 
keybind = cmd+a=ignore
