#!/bin/bash
#
# sketchybar config — Catppuccin Mocha
# AeroSpace integration, 10 workspaces
# Fonts: JetBrainsMono Nerd Font + sketchybar-app-font

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ═══════════════════════════════════════════════════════════
# BAR
# ═══════════════════════════════════════════════════════════

sketchybar --bar position=top \
               height=38 \
               notch_width=200 \
               blur_radius=30 \
               color=0x00000000 \
               display=main \
               topmost=window \
               margin_left=8 \
               margin_right=8

# ═══════════════════════════════════════════════════════════
# DEFAULTS
# ═══════════════════════════════════════════════════════════

sketchybar --default \
           animator_duration=250 \
           padding_left=4 \
           padding_right=4 \
           icon.font="JetBrainsMono Nerd Font:14.0" \
           label.font="JetBrainsMono Nerd Font:Bold:13.0" \
           icon.color=0xffcba6f7 \
           label.color=0xffcba6f7 \
           icon.padding_left=8 \
           icon.padding_right=4 \
           label.padding_left=4 \
           label.padding_right=8 \
           background.color=0xcc1e1e2e \
           background.border_color=0x44cba6f7 \
           background.border_width=1 \
           background.corner_radius=6 \
           background.height=28 \
           blur_radius=30

# ═══════════════════════════════════════════════════════════
# SPACE INDICATORS (left side)
# icon = circled number (❶→❿), label = app icons
# ═══════════════════════════════════════════════════════════

SPACE_SIDS=(1 2 3 4 5)
for sid in "${SPACE_SIDS[@]}"; do
  sketchybar --add item space.$sid left \
             --set space.$sid \
                      icon=$sid \
                      icon.font="JetBrainsMono Nerd Font:Bold:17.0" \
                      icon.padding_left=8 \
                      icon.padding_right=8 \
                      icon.color=0xffcba6f7 \
                      label.drawing=off \
                      background.color=0xcc1e1e2e \
                      background.border_color=0x44cba6f7 \
                      background.border_width=1 \
                      background.corner_radius=6 \
                      background.height=30 \
                      script="$PLUGIN_DIR/space.sh" \
                      click_script="aerospace workspace $sid" \
             --subscribe space.$sid aerospace_workspace_change front_app_switched
done

# ═══════════════════════════════════════════════════════════
# FRONT APP (right side — before date, notch-safe)
# Icon = sketchybar-app-font, label = app name
# ═══════════════════════════════════════════════════════════

sketchybar --add item front_app left \
           --set front_app icon.font="sketchybar-app-font:Regular:19.0" \
                           icon.color=0xffcba6f7 \
                           label.color=0xffcdd6f4 \
                           label.font="JetBrainsMono Nerd Font:Bold:12.0" \
                           background.color=0xcc313244 \
                           background.border_color=0x88cba6f7 \
                           background.border_width=1 \
                           background.corner_radius=6 \
                           background.height=28 \
                           icon.padding_left=8 \
                           icon.padding_right=4 \
                           label.padding_left=2 \
                           label.padding_right=8 \
                           script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

# ═══════════════════════════════════════════════════════════
# DATE (right side) — click for network popup
# ═══════════════════════════════════════════════════════════

sketchybar --add item date right \
           --set date icon=􀧞 \
                      icon.color=0xffcba6f7 \
                      label.color=0xffcdd6f4 \
                      update_freq=5 \
                      script="$PLUGIN_DIR/calendar.sh" \
                      popup.align=center \
                      popup.y_offset=-2 \
                      popup.background.color=0xcc1e1e2e \
                      popup.background.border_color=0x44cba6f7 \
                      popup.background.border_width=1 \
                      popup.background.corner_radius=10 \
                      popup.width=180 \
           --subscribe date mouse.clicked \
           --add item date.wifi popup.date \
           --set date.wifi icon=󰤨 \
                            icon.color=0xffcba6f7 \
                            icon.padding_left=10 \
                            label.color=0xffcdd6f4 \
                            label.font="JetBrainsMono Nerd Font:Bold:13.0" \
                            label.width=220 \
                            label.padding_right=10 \
                            background.drawing=off \
           --add item date.band popup.date \
           --set date.band icon=󰖩 \
                           icon.color=0xffcba6f7 \
                           icon.padding_left=10 \
                           label.color=0xffcdd6f4 \
                           label.font="JetBrainsMono Nerd Font:Bold:13.0" \
                           label.width=220 \
                           label.padding_right=10 \
                           background.drawing=off \
           --add item date.vpn popup.date \
           --set date.vpn icon=󰒝 \
                           icon.color=0xffcba6f7 \
                           icon.padding_left=10 \
                           label.color=0xffcdd6f4 \
                           label.font="JetBrainsMono Nerd Font:Bold:13.0" \
                           label.width=220 \
                           label.padding_right=10 \
                           background.drawing=off \
           --add item date.uptime popup.date \
           --set date.uptime icon=􀐫 \
                            icon.color=0xffcba6f7 \
                            icon.padding_left=10 \
                            label.color=0xffcdd6f4 \
                            label.font="JetBrainsMono Nerd Font:Bold:13.0" \
                            label.width=220 \
                            label.padding_right=10 \
                            background.drawing=off

# ═══════════════════════════════════════════════════════════
# BATTERY (right side)
# ═══════════════════════════════════════════════════════════

sketchybar --add item battery right \
           --set battery icon.color=0xffcba6f7 \
                         label.color=0xffcdd6f4 \
                         update_freq=10 \
                         script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change mouse.clicked

# ═══════════════════════════════════════════════════════════
# VOLUME (right side) — slider popup on click
# ═══════════════════════════════════════════════════════════

sketchybar --add item volume_icon right \
           --set volume_icon icon.color=0xffcba6f7 \
                            label.color=0xffcdd6f4 \
                            script="$PLUGIN_DIR/volume.sh" \
                            popup.align=center \
                            popup.background.color=0xcc1e1e2e \
                            popup.background.border_color=0x44cba6f7 \
                            popup.background.border_width=1 \
                            popup.background.corner_radius=6 \
                            popup.background.height=18 \
                            popup.y_offset=-2 \
           --subscribe volume_icon volume_change mouse.clicked \
             --add slider volume_slider popup.volume_icon \
             --set volume_slider slider.width=150 \
                                 slider.background.height=4 \
                                 slider.background.corner_radius=2 \
                                 slider.background.color=0xff313244 \
                                 slider.highlight_color=0xffcba6f7 \
                                 slider.knob=􀀁 \
                                 background.drawing=off \
                                 background.height=2 \
                                 padding_left=10 \
                                 padding_right=10 \
                                 script="$PLUGIN_DIR/volume.sh" \
             --subscribe volume_slider volume_change mouse.clicked mouse.entered mouse.exited

# ═══════════════════════════════════════════════════════════
# INVISIBLE WATCHER — updates space app icons every second
# ═══════════════════════════════════════════════════════════

sketchybar --add item space_watcher right \
           --set space_watcher drawing=off \
                                update_freq=1 \
                                script="$PLUGIN_DIR/space_windows.sh" \
           --subscribe space_watcher space_change

# ═══════════════════════════════════════════════════════════
# AEROSPACE SIGNALS
# ═══════════════════════════════════════════════════════════

sketchybar --add event aerospace_workspace_change

sketchybar --update

# Initial trigger
sketchybar --trigger aerospace_workspace_change FOCUSED_WORKSPACE=$(aerospace list-workspaces --focused)
